# ============================================================
# Скопируй в .env и заполни.  .env в .gitignore - НЕ коммить.
#   cp .env.example .env
# ============================================================

# ---------- Postgres ----------
# Задаёт и пользователя, и имя базы, и пароль, который уходит в backend
# (DATABASE_USERNAME/PASSWORD подставляются отсюда же - см. docker-compose.yml).
POSTGRES_DB=gamedoor
POSTGRES_USER=gamedoor
POSTGRES_PASSWORD=

# ---------- Strapi secrets ----------
# Каждый секрет - случайная строка. Сгенерировать все разом:
#   openssl rand -base64 32
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# ---------- Порты на хосте ----------
# Внутренние порты контейнеров фиксированы (1337 и 3000) и задаются в
# docker-compose.yml. Здесь меняется только хостовый порт - на VPS 1337
# может быть занят другим сервисом.
BACKEND_PORT=1337
FRONTEND_PORT=3000

# ---------- Адреса для реверс-прокси ----------
# Оставь '/' и '/admin' для варианта "всё на одном домене за одним прокси"
# (https://example.com -> frontend, https://example.com/admin -> backend).
#
# Если Dockploy отдаёт админку на ОТДЕЛЬНЫЙ поддомен, укажи полные URL -
# иначе после логина Strapi сделает редирект на http://backend:1337/admin,
# который из браузера не открывается:
#   STRAPI_ADMIN_URL=https://admin.example.com
#   STRAPI_PUBLIC_URL=https://api.example.com
STRAPI_PUBLIC_URL=/
STRAPI_ADMIN_URL=/admin

# ---------- CORS ----------
# Пусто или * = разрешить любые источники. Для боевого домена лучше сузить:
#   CORS_ORIGIN=https://example.com,https://www.example.com
CORS_ORIGIN=*

# ---------- Frontend -> Strapi ----------
# Server-side адрес Strapi, который читает frontend/lib/strapiAds.ts.
# Внутри docker-сети всегда http://backend:1337 - так и оставь, если
# оба сервиса в одной сети.
STRAPI_API_URL=http://backend:1337
